---
/**
 * Starlight PageTitle override: the stock <h1> plus, on lesson pages, a "Lesson N · Module M — Title" eyebrow
 * derived from course.json in the page's language (frontmatter titles carry no numbers).
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { courseIn, langOf } from '../../lib/course';

const v = courseIn(langOf(Astro.url.pathname));
const lesson = v.lessonByPath(Astro.locals.starlightRoute.id);
---

{
	lesson && (
		<p class="lesson-eyebrow">
			{v.tf('eyebrowLesson', { n: lesson.num })} ·{' '}
			<a href={v.moduleHref(lesson.moduleSlug)}>
				{v.tf('eyebrowModule', { n: lesson.moduleNum, title: lesson.moduleTitle })}
				{lesson.optional && ` ${v.t.optional}`}
			</a>
		</p>
	)
}
<Default><slot /></Default>

<style>
	.lesson-eyebrow {
		margin: 0;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--sl-color-accent-high);
	}
	.lesson-eyebrow a {
		color: inherit;
		text-decoration: none;
	}
	.lesson-eyebrow a:hover {
		text-decoration: underline;
	}
	.lesson-eyebrow + :global(h1) {
		margin-top: 0.25rem;
	}
</style>

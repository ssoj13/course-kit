---
/**
 * Starlight PageTitle override: the stock <h1> plus an eyebrow derived from course.json in the page's language
 * (frontmatter titles carry no numbers): "Lesson N · Module M — Title" on lesson pages, "Lab · Lesson N — Title" on
 * lab pages ("Lab" links to the catalog; the lesson part only for a lab that belongs to a lesson).
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { courseIn, langOf } from '../../lib/course';

const v = courseIn(langOf(Astro.url.pathname));
const id = Astro.locals.starlightRoute.id;
const lesson = v.lessonByPath(id);
const lab = lesson ? undefined : v.labByPath(id);
---

{
	lesson && (
		<p class="lesson-eyebrow">
			{v.tf('eyebrowLesson', { n: lesson.num })} ·{' '}
			<a href={v.moduleHref(lesson.moduleSlug)}>
				{v.tf('eyebrowModule', { n: lesson.moduleNum, title: lesson.moduleTitle })}
				{lesson.optional && ` ${v.t.optional}`}
			</a>
		</p>
	)
}
{
	lab && (
		<p class="lesson-eyebrow">
			<a href={v.pageHref('labs')}>{v.t.eyebrowLab}</a>
			{lab.lesson && (
				<>
					{' · '}
					<a href={v.href(lab.lesson.slug)}>{v.tf('eyebrowLabLesson', { n: lab.lesson.num, title: lab.lesson.title })}</a>
				</>
			)}
		</p>
	)
}
<Default><slot /></Default>

<style>
	.lesson-eyebrow {
		margin: 0;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--sl-color-accent-high);
	}
	.lesson-eyebrow a {
		color: inherit;
		text-decoration: none;
	}
	.lesson-eyebrow a:hover {
		text-decoration: underline;
	}
	.lesson-eyebrow + :global(h1) {
		margin-top: 0.25rem;
	}
</style>

---
/**
 * Starlight Footer override: on lesson pages renders the completion toggle above the stock footer, so lesson
 * files need no per-lesson chrome. Prev/next links come from the route middleware (course order, page language).
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import LessonDone from '../LessonDone.astro';
import { courseIn, langOf } from '../../lib/course';

const lesson = courseIn(langOf(Astro.url.pathname)).lessonByPath(Astro.locals.starlightRoute.id);
---

{lesson && <LessonDone lesson={lesson.slug} />}
<Default><slot /></Default>

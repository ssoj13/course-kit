---
/**
 * Inline term reference: `<Term id="vk-instance" />` or `<Term id="vk-instance">instances</Term>`.
 * Links to the glossary entry in the page's language and shows the one-line definition on hover/focus.
 * An unknown id fails the build.
 */
import { graphIn } from '../lib/terms';
import { term } from '../lib/graph';
import { courseIn, langOf } from '../lib/course';

interface Props {
	id: string;
}

const lang = langOf(Astro.url.pathname);
const t = term(graphIn(lang), Astro.props.id);
const url = courseIn(lang).resolveLink(`term:${t.id}`)!;
---

<a class="ck-term" href={url} title={t.def}><slot>{t.label}</slot></a>

<style>
	.ck-term {
		text-decoration: underline dotted;
		text-underline-offset: 0.2em;
	}
</style>

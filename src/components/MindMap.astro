---
/**
 * Mind map of the term graph, in the page's language. Selects a subgraph (lib/graph.ts), lays it out at build time
 * (lib/layout.ts: foundations on top, rows left to right in course order) and hands the picture to the GraphView
 * island. The same subgraph is printed as a text list, readable without JS and by screen readers.
 *
 * Usage in MDX:
 *   <MindMap />                              current lesson's terms and their neighbours
 *   <MindMap lesson="instance" />            another lesson's map
 *   <MindMap term="device" />                one hop around a term (`hops` widens it)
 *   <MindMap term="device" mode="genealogy" /> what the term is built on, down to the roots
 *   <MindMap term="instance" mode="unlocks" /> everything built on the term
 *   <MindMap mode="all" />                   the whole graph
 */
import GraphView, { type ViewEdge, type ViewNode } from './graph/GraphView.tsx';
import { HIERARCHY, ancestors, descendants, everything, lessonMap, neighborhood, type EdgeType, type SubGraph } from '../lib/graph';
import { graphIn } from '../lib/terms';
import { canvasHeight, layout } from '../lib/layout';
import { courseIn, langOf } from '../lib/course';
import { REL_KEY } from '../i18n.mjs';
import { EDGE_TYPES } from '../data.mjs';

interface Props {
	term?: string;
	lesson?: string;
	mode?: 'around' | 'genealogy' | 'unlocks' | 'all';
	hops?: number;
	/** Caption under the map. */
	caption?: string;
}

const v = courseIn(langOf(Astro.url.pathname));
const graph = graphIn(v.lang);
const { term, mode = 'around', hops = 1, caption } = Astro.props;
const lesson = Astro.props.lesson ?? (term || mode === 'all' ? undefined : v.lessonByPath(Astro.locals.starlightRoute?.id ?? '')?.slug);

let sub: SubGraph;
if (mode === 'all') sub = everything(graph);
else if (term) sub = mode === 'genealogy' ? ancestors(graph, term) : mode === 'unlocks' ? descendants(graph, term) : neighborhood(graph, term, hops);
else if (lesson) sub = lessonMap(graph, lesson);
else throw new Error('<MindMap>: pass `term`, `lesson` or mode="all" (or use it on a lesson page)');

// Course position of a term (its lesson number; untaught terms last), for left-to-right order inside a row.
const courseOrder = (lessonSlug?: string) => (lessonSlug ? (v.lessonBySlug(lessonSlug)?.num ?? 1e6) : 1e6);
// Foundations on top: a hierarchy relation `from -> to` ("device is built on physical device") puts `to` above.
const laid = layout({
	nodes: sub.terms.map((t, i) => ({ id: t.id, label: t.label, order: courseOrder(t.lesson) * 1000 + i })),
	links: sub.edges.filter((e) => HIERARCHY.includes(e.type)).map((e) => ({ source: e.to, target: e.from })),
});
const placed = new Map(laid.nodes.map((n) => [n.id, n]));
/** API identifiers (VkDevice, VK_EXT_..., vkCreate...) get a monospace title. */
const isCode = (label: string) => /^(Vk[A-Z]|VK_|vk[A-Z])/.test(label);
const layerLabel = (id: string) => graph.layers[graph.layerIndex.get(id) ?? 0]?.label ?? id;

const nodes: ViewNode[] = sub.terms.map((t) => {
	const p = placed.get(t.id)!;
	const taught = t.lesson ? v.lessonBySlug(t.lesson) : undefined;
	return {
		id: t.id,
		label: t.label,
		def: t.def,
		layer: graph.layerIndex.get(t.layer) ?? 0,
		layerLabel: layerLabel(t.layer),
		href: taught ? v.href(taught.slug) : v.resolveLink(`term:${t.id}`)!,
		hrefLabel: taught ? v.tf('lessonLink', { n: taught.num, title: taught.title }) : v.t.glossaryLink,
		x: p.x,
		y: p.y,
		w: p.w,
		h: p.h,
		focus: t.id === term || (!term && t.lesson === lesson),
		code: isCode(t.label),
	};
});
const edges: ViewEdge[] = sub.edges.map((e) => ({ from: e.from, to: e.to, type: e.type, label: e.label }));
const legend = EDGE_TYPES.filter((t: EdgeType) => edges.some((e) => e.type === t));
// Colors follow the global layer index, so the legend keeps each used layer's index.
const legendLayers = graph.layers.flatMap((l, index) => (sub.terms.some((t) => t.layer === l.id) ? [{ label: l.label, index }] : []));

const byId = new Map(sub.terms.map((t) => [t.id, t.label]));
const height = canvasHeight(laid);
---

<figure class="ck-mindmap not-content">
	<div class="ck-mindmap-frame" style={`min-height:${height + 120}px`}>
		<GraphView client:only="react" lang={v.lang} nodes={nodes} edges={edges} height={height} legend={legend} layers={legendLayers} />
	</div>
	{caption && <figcaption>{caption}</figcaption>}
	<details class="ck-mindmap-text">
		<summary>{v.t.mapAsText}</summary>
		<ul>
			{sub.terms.map((t) => <li><b>{t.label}</b>: {t.def}</li>)}
		</ul>
		{
			edges.length > 0 && (
				<ul>
					{edges.map((e) => (
						<li>
							{byId.get(e.from)} {e.label ?? v.t[REL_KEY[e.type].rel]} {byId.get(e.to)}
						</li>
					))}
				</ul>
			)
		}
	</details>
</figure>

<style>
	.ck-mindmap {
		margin: 1.5rem 0;
	}
	figcaption {
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.ck-mindmap-text {
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
	}
	.ck-mindmap-text summary {
		cursor: pointer;
		color: var(--sl-color-gray-3);
	}
</style>

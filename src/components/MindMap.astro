---
/**
 * Mind map of the term graph, in the page's language, drawn as a concept tree (graph/TreeView.tsx). The term graph is
 * not a tree, so every term hangs off ONE primary parent: the term it relates to most strongly (built-on > part-of >
 * is-a > uses > related, cycles avoided by lib/tree.ts `pickParents`); its other relations become dashed wires or
 * "+ ..." notes. Colors = depth layers. The same subgraph is printed as a text list, readable without JS and by screen
 * readers.
 *
 * Usage in MDX:
 *   <MindMap />                              current lesson's terms and their neighbours, under a "Lesson N" root
 *   <MindMap lesson="instance" />            another lesson's map
 *   <MindMap term="device" />                one hop around a term (`hops` widens it)
 *   <MindMap term="device" mode="genealogy" /> what the term is built on, down to the roots
 *   <MindMap term="instance" mode="unlocks" /> everything built on the term
 *   <MindMap mode="all" />                   the whole graph (a forest: roots = terms built on nothing)
 */
import TreeView, { type TreeGroup, type TreeItem } from './graph/TreeView.tsx';
import { ancestors, descendants, everything, isCode, lessonMap, neighborhood, type EdgeJson, type EdgeType, type SubGraph } from '../lib/graph';
import { pickParents, type Candidate } from '../lib/tree';
import { graphIn } from '../lib/terms';
import { courseIn, langOf } from '../lib/course';
import { REL_KEY } from '../i18n.mjs';

interface Props {
	term?: string;
	lesson?: string;
	mode?: 'around' | 'genealogy' | 'unlocks' | 'all';
	hops?: number;
	/** Caption under the map. */
	caption?: string;
}

const v = courseIn(langOf(Astro.url.pathname));
const graph = graphIn(v.lang);
const { term, mode = 'around', hops = 1, caption } = Astro.props;
const lesson = Astro.props.lesson ?? (term || mode === 'all' ? undefined : v.lessonByPath(Astro.locals.starlightRoute?.id ?? '')?.slug);

let sub: SubGraph;
if (mode === 'all') sub = everything(graph);
else if (term) sub = mode === 'genealogy' ? ancestors(graph, term) : mode === 'unlocks' ? descendants(graph, term) : neighborhood(graph, term, hops);
else if (lesson) sub = lessonMap(graph, lesson);
else throw new Error('<MindMap>: pass `term`, `lesson` or mode="all" (or use it on a lesson page)');

/** Which relation makes the better primary parent: the hierarchy ones first, the loose ones last. */
const PRIO: Record<EdgeType, number> = { 'built-on': 0, 'part-of': 1, 'is-a': 2, uses: 3, related: 4 };
const ids = sub.terms.map((t) => t.id);
const out = new Map<string, EdgeJson[]>(ids.map((id) => [id, []]));
for (const e of sub.edges) out.get(e.from)!.push(e);
for (const list of out.values()) list.sort((a, b) => PRIO[a.type] - PRIO[b.type]);
const cands = new Map<string, Candidate[]>([...out].map(([id, es]) => [id, es.map((e) => ({ to: e.to, prio: PRIO[e.type] }))]));
const { parent } = pickParents(ids, cands);
/** A relation read from its `from` term ("device is built on physical device"). */
const relOf = (e: EdgeJson) => e.label ?? v.t[REL_KEY[e.type].rel];

const byId = new Map(sub.terms.map((t) => [t.id, t.label]));
const ROOT = '__lesson';
const here = lesson && !term && mode !== 'all' ? v.lessonBySlug(lesson) : undefined;
const items: TreeItem[] = sub.terms.map((t) => {
	const taught = t.lesson ? v.lessonBySlug(t.lesson) : undefined;
	const p = parent.get(t.id) ?? null;
	const up = p ? out.get(t.id)!.find((e) => e.to === p)! : undefined;
	const muted = !!here && t.lesson !== here.slug;
	return {
		id: t.id,
		label: t.label,
		def: t.def,
		group: t.layer,
		parent: p ?? (here ? ROOT : null),
		// The connector reads from the parent to this term ("physical device is the base of device").
		rel: up ? v.t[REL_KEY[up.type].wire] : undefined,
		relUp: up ? relOf(up) : undefined,
		extra: out
			.get(t.id)!
			// One wire per pair of terms: a second relation to the same term is still listed in `facts`.
			.filter((e, i, all) => e.to !== p && all.findIndex((x) => x.to === e.to) === i)
			.map((e) => ({ id: e.to, rel: relOf(e) })),
		code: isCode(t.label),
		muted,
		sub: muted && taught ? v.tf('treeFromLesson', { n: taught.num }) : undefined,
		facts: sub.edges.filter((e) => e.from === t.id || e.to === t.id).map((e) => `${byId.get(e.from)} ${relOf(e)} ${byId.get(e.to)}`),
		href: taught ? v.href(taught.slug) : v.resolveLink(`term:${t.id}`)!,
		hrefLabel: taught ? v.tf('lessonLink', { n: taught.num, title: taught.title }) : v.t.glossaryLink,
	};
});
if (here) items.unshift({ id: ROOT, label: v.tf('treeLessonRoot', { n: here.num, title: here.title }), def: v.t.treeLessonRootDef, group: '' });
// Colors follow the global layer index, so a layer keeps its color on every map.
const groups: TreeGroup[] = graph.layers.map((l, i) => ({ id: l.id, label: l.label, color: `var(--ck-l${i % 6})` }));
const reveal = here ? sub.terms.filter((t) => t.lesson === here.slug).map((t) => t.id) : mode === 'all' ? undefined : 'all';
const label = here ? v.tf('moduleLessonMap', { n: here.num, title: here.title }) : v.t.knowledgeMap;
---

<figure class="ck-mindmap not-content">
	<TreeView client:only="react" lang={v.lang} items={items} groups={groups} reveal={reveal} label={label} prefer={mode === 'all' ? 'collapse' : undefined} />
	{caption && <figcaption>{caption}</figcaption>}
	<details class="ck-mindmap-text">
		<summary>{v.t.mapAsText}</summary>
		<ul>
			{sub.terms.map((t) => <li><b>{t.label}</b>: {t.def}</li>)}
		</ul>
		{
			sub.edges.length > 0 && (
				<ul>
					{sub.edges.map((e) => (
						<li>
							{byId.get(e.from)} {relOf(e)} {byId.get(e.to)}
						</li>
					))}
				</ul>
			)
		}
	</details>
</figure>

<style>
	.ck-mindmap {
		margin: 1.5rem 0;
		min-height: 10rem;
	}
	figcaption {
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.ck-mindmap-text {
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
	}
	.ck-mindmap-text summary {
		cursor: pointer;
		color: var(--sl-color-gray-3);
	}
</style>

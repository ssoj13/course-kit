---
/**
 * Course roadmap graph from course.json, read like a file tree: modules top to bottom in course order, each
 * module's lessons below it and indented to the right, all on one spine. A fixed grid computed here (no layout
 * engine needed for a depth-2 tree) keeps it narrow enough to read at full size in the content column.
 */
import RoadmapView, { type RoadEdge, type RoadNode } from './graph/RoadmapView.tsx';
import { href, moduleHref, modules } from '../lib/course';

const MOD_W = 330;
const LES_W = 300;
const INDENT = 56;
const MOD_H = 46;
const LES_H = 38;
const GAP = 14;
const MOD_GAP = 30;

const nodes: RoadNode[] = [];
const edges: RoadEdge[] = [];
let y = 0;
let prev: string | undefined;
for (const m of modules) {
	const id = `m:${m.slug}`;
	nodes.push({
		id,
		kind: 'module',
		label: `${m.num}. ${m.title}`,
		href: moduleHref(m.slug),
		slug: '',
		lessons: m.lessons.map((l) => l.slug),
		optional: m.optional,
		x: 0,
		y,
		w: MOD_W,
		h: MOD_H,
	});
	if (prev) edges.push({ from: prev, to: id, spine: true });
	prev = id;
	y += MOD_H + GAP;
	for (const l of m.lessons) {
		nodes.push({
			id: `l:${l.slug}`,
			kind: 'lesson',
			label: `${l.num}. ${l.label}`,
			href: href(l.slug),
			slug: l.slug,
			lessons: [],
			optional: l.optional,
			x: INDENT,
			y,
			w: LES_W,
			h: LES_H,
		});
		edges.push({ from: id, to: `l:${l.slug}`, spine: false });
		y += LES_H + GAP;
	}
	y += MOD_GAP - GAP;
}
const height = Math.min(820, y + 40);
---

<figure class="ck-roadmap not-content">
	<div style={`min-height:${height + 2}px`}>
		<RoadmapView client:only="react" nodes={nodes} edges={edges} height={height} />
	</div>
	<figcaption>Modules run top to bottom; each module's lessons follow it. Completed lessons turn green.</figcaption>
</figure>

<style>
	.ck-roadmap {
		margin: 1.5rem 0;
	}
	figcaption {
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>

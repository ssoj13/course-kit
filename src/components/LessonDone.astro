---
/**
 * "Mark lesson complete" toggle + overall progress bar, rendered by the Footer override on every lesson page.
 * State lives in KEYS.progress (Record<lesson slug, boolean>), shared with ProgressExport and every language.
 * The lesson is the current route's; the optional `lesson` slug prop exists for tests. When browser storage is
 * blocked, store.ts keeps the record in memory for this page view, so the toggle still works.
 */
import { courseIn, langOf } from '../lib/course';

interface Props {
	lesson?: string;
}

const v = courseIn(langOf(Astro.url.pathname));
const slug = Astro.props.lesson ?? v.lessonByPath(Astro.locals.starlightRoute?.id ?? '')?.slug;
const lesson = slug ? v.lessonBySlug(slug) : undefined;
if (!lesson) {
	throw new Error(`<LessonDone>: not a lesson page and no valid \`lesson\` slug (got ${JSON.stringify(slug)}).`);
}
const i18n = JSON.stringify({ markComplete: v.t.markComplete, completed: v.t.completed, completedSummary: v.t.completedSummary });
---

<lab-lesson-done class="lab-card not-content" data-lesson={lesson.slug} data-lang={v.lang} data-i18n={i18n}>
	<p class="lab-eyebrow">{v.t.progress}</p>
	<div class="lab-row">
		<button type="button" class="lab-button" data-ref="toggle" aria-pressed="false">{v.t.markComplete}</button>
		<span class="lab-muted" data-ref="label"></span>
	</div>
	<progress class="done-bar" data-ref="bar" max="1" value="0" aria-label={v.t.coreProgress}></progress>
	<p class="lab-msg is-warn" data-ref="warn" hidden>{v.t.storageBlocked}</p>
</lab-lesson-done>

<style>
	.done-bar {
		display: block;
		width: 100%;
		height: 0.55rem;
		margin-top: 0.75rem;
		accent-color: var(--lab-accent);
	}
	[aria-pressed='true'] {
		border-color: var(--lab-ok);
		color: var(--lab-ok);
	}
	lab-lesson-done {
		margin-top: 2rem;
	}
</style>

<script>
	import { LabElement, define } from '../lib/element';
	import { KEYS } from '../lib/store';
	import { counts, describe, markSidebar, readProgress, toggleLesson } from '../lib/progress';

	class LabLessonDone extends LabElement {
		protected mount() {
			this.on(this.ref('toggle'), 'click', () => {
				// toggleLesson() always notifies watchers (this and sibling widgets re-render), even when only the
				// in-memory fallback took the value.
				if (!toggleLesson(this.dataset.lesson ?? '')) this.ref('warn').hidden = false;
			});
			this.watch(KEYS.progress, () => this.render());
			this.render();
		}

		private render(): void {
			const progress = readProgress();
			const done = progress[this.dataset.lesson ?? ''] === true;
			const c = counts(progress);
			const btn = this.ref<HTMLButtonElement>('toggle');
			btn.textContent = this.text(done ? 'completed' : 'markComplete');
			btn.setAttribute('aria-pressed', String(done));
			this.ref('label').textContent = this.text('completedSummary', { summary: describe(progress, this.dataset.lang ?? '') });
			const bar = this.ref<HTMLProgressElement>('bar');
			bar.max = c.coreTotal;
			bar.value = c.core;
			markSidebar(progress);
		}
	}
	define('lab-lesson-done', LabLessonDone);
</script>

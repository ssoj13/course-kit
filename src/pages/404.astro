---
/**
 * Custom 404 (Starlight's own route is disabled via `disable404Route`). GitHub Pages serves this one file at any
 * missing path of any language, so it is in the default language and links to every language's home page; links
 * are absolute and include the base path.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { DEFAULT_LANG, LANGUAGES, courseIn } from '../lib/course';

const v = courseIn(DEFAULT_LANG);
const others = LANGUAGES.slice(1).map((l) => ({ text: l.label, link: courseIn(l.code).pageHref(''), variant: 'minimal' as const }));
---

<StarlightPage
	frontmatter={{
		title: v.t.notFound,
		template: 'splash',
		editUrl: false,
		pagefind: false,
		hero: {
			title: v.t.notFound,
			tagline: v.t.notFoundTagline,
			actions: [
				{ text: v.t.startCourse, link: v.href(v.lessons[0]!.slug), icon: 'right-arrow' },
				{ text: v.t.roadmap, link: v.pageHref('roadmap'), variant: 'minimal' },
				...others,
			],
		},
	}}
/>

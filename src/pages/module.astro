---
/**
 * Module overview pages (`/<module>/`), one per course.json module: summary, the module's lessons, the module's
 * knowledge map and links to the neighbouring modules. Generated, so a module never needs a hand-written index.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CourseMap from '../components/CourseMap.astro';
import MindMap from '../components/MindMap.astro';
import { href, moduleHref, modules, pageHref, type Module } from '../lib/course';
import { graph } from '../lib/terms';

export function getStaticPaths() {
	return modules.map((m) => ({ params: { module: m.slug }, props: { mod: m } }));
}

interface Props {
	mod: Module;
}

const { mod } = Astro.props;
const prev = modules[mod.num - 2];
const next = modules[mod.num];
const first = mod.lessons[0];
if (!first) throw new Error(`course.json: module "${mod.slug}" has no lessons`);
// The module map: terms of its lessons and their neighbors. Lessons without terms are skipped.
const mapLessons = mod.lessons.filter((l) => graph.terms.some((t) => t.lesson === l.slug));
---

<StarlightPage
	frontmatter={{
		title: `Module ${mod.num}: ${mod.title}${mod.optional ? ' (optional)' : ''}`,
		description: mod.summary,
		editUrl: false,
	}}
>
	<p>{mod.summary}</p>
	<p>
		{mod.lessons.length} lessons, {first.num}–{first.num + mod.lessons.length - 1} of the course. <a href={href(first.slug)}>Start with lesson {first.num}: {first.title}</a>.
	</p>
	<CourseMap module={mod.slug} />
	{
		mapLessons.map((l) => (
			<>
				<h2>Map of lesson {l.num}: {l.title}</h2>
				<MindMap lesson={l.slug} />
			</>
		))
	}
	<nav class="module-nav not-content" aria-label="Modules">
		{prev ? <a href={moduleHref(prev.slug)}>← Module {prev.num}: {prev.title}</a> : <span />}
		<a href={pageHref('roadmap')}>All modules</a>
		{next ? <a href={moduleHref(next.slug)}>Module {next.num}: {next.title} →</a> : <span />}
	</nav>
</StarlightPage>

<style>
	.module-nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 2rem;
		font-size: var(--sl-text-sm);
	}
</style>

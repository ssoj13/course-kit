---
/**
 * Course roadmap: the roadmap.sh-style graph of modules and lessons, the knowledge map of every term, the lesson
 * tables and the progress export - all generated from course.json and terms.json.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Roadmap from '../components/Roadmap.astro';
import MindMap from '../components/MindMap.astro';
import CourseMap from '../components/CourseMap.astro';
import ProgressExport from '../components/ProgressExport.astro';
import { COURSE_TITLE } from '../lib/course';
import { graph } from '../lib/terms';
---

<StarlightPage frontmatter={{ title: 'Course roadmap', description: `Every module and lesson of ${COURSE_TITLE}.`, editUrl: false }}>
	<p>The whole course on one page. Each step builds on the ones above it; click any box to open it.</p>
	<Roadmap />
	{
		graph.terms.length > 0 && (
			<>
				<h2>Knowledge map</h2>
				<p>Every concept of the course and what it is built on. Foundations sit at the bottom.</p>
				<MindMap mode="all" />
			</>
		)
	}
	<h2>Lessons</h2>
	<CourseMap />
	<ProgressExport />
</StarlightPage>
